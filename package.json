{
  "name": "hala-site",
  "description": "The marketing website for Hala, a bilingual AI booking assistant (portfolio project).",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "serve": "wrangler pages dev --port 8788",
    "check": "astro check",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lighthouse": "lhci autorun",
    "smoke": "node scripts/smoke.mjs",
    "tokens:check": "node scripts/tokens.mjs check",
    "tokens:sync": "node scripts/tokens.mjs sync",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.3",
    "@phosphor-icons/core": "^2.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "1.63.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "5.0.3",
    "wrangler": "4.149.0"
  }
}
