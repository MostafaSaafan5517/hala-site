---
// A Phosphor icon (regular weight, Hala's icon family), inlined at build time: no JavaScript and
// no extra request. Icons accompany words, so they are hidden from screen readers.
import { icons, type IconName } from "./icons";

interface Props {
  name: IconName;
  /** 16px beside body text, 18 to 20px in buttons (Hala's DESIGN.md, Icons). */
  size?: number;
  /** Arrows point the way the text reads: mirrored in right-to-left pages. */
  mirrorInRtl?: boolean;
  class?: string;
}

const { name, size = 16, mirrorInRtl = false, class: className = "" } = Astro.props;
const classes = ["shrink-0", mirrorInRtl ? "rtl:-scale-x-100" : "", className]
  .filter(Boolean)
  .join(" ");
const svg = icons[name].replace(
  "<svg ",
  `<svg width="${size}" height="${size}" aria-hidden="true" focusable="false" class="${classes}" `,
);
---

<Fragment set:html={svg} />
