---
// A real Hala screen, served as AVIF with a WebP fallback (never the large original) in a few
// widths, with its width and height set so nothing shifts while it loads. Below the fold it loads
// lazily; the hero's image asks for priority instead.
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string | undefined;
  /** The widths to generate, and how wide the image is shown at each breakpoint. */
  widths: number[];
  sizes: string;
  priority?: boolean;
  class?: string;
}

const { src, alt, caption, widths, sizes, priority = false, class: className } = Astro.props;
---

<figure class={className}>
  <Picture
    src={src}
    alt={alt}
    widths={widths.filter((width) => width <= src.width)}
    sizes={sizes}
    formats={["avif"]}
    fallbackFormat="webp"
    loading={priority ? "eager" : "lazy"}
    fetchpriority={priority ? "high" : "auto"}
    decoding="async"
    class="h-auto w-full rounded-surface shadow-level-2"
  />
  {caption && <figcaption class="mt-3 text-small text-muted-foreground">{caption}</figcaption>}
</figure>
