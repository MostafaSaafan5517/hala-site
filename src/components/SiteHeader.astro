---
import { site } from "../config/site";
import { brandName } from "../i18n/brand";
import type { Locale } from "../i18n/locales";
import { ui } from "../i18n/ui";
import Icon from "./Icon.astro";
import LanguageSwitch from "./LanguageSwitch.astro";
import Wordmark from "./Wordmark.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const words = ui[locale];
---

<header>
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
    <a href={`/${locale}/`} aria-label={words.homeLink(brandName(locale))} class="rounded-control">
      <Wordmark />
    </a>
    <div class="flex items-center gap-2">
      <LanguageSwitch locale={locale === "en" ? "ar" : "en"} />
      <!-- The page's own call to action takes over on phones, where the header has no room. -->
      <a
        href={site.demoUrl}
        class="hidden h-10 items-center gap-2 rounded-control bg-primary px-4 text-small font-medium whitespace-nowrap text-primary-foreground hover:bg-primary-strong active:translate-y-px motion-safe:transition-[background-color,transform] sm:inline-flex"
      >
        {words.tryDemo}
        <Icon name="arrow-up-right" size={18} mirrorInRtl />
      </a>
    </div>
  </div>
</header>
