---
import { primaryButton } from "../../../components/buttons";
import FeatureSection from "../../../components/FeatureSection.astro";
import Icon from "../../../components/Icon.astro";
import Screenshot from "../../../components/Screenshot.astro";
import { site } from "../../../config/site";
import { isLocale } from "../../../i18n/locales";
import { ui } from "../../../i18n/ui";
import SiteLayout from "../../../layouts/SiteLayout.astro";
import { everyLanguage, pageCopy } from "../../../lib/content";

export const getStaticPaths = everyLanguage;

const { lang } = Astro.params;
if (!isLocale(lang)) throw new Error(`Unknown language "${lang}"`);
const locale = lang;
const copy = await pageCopy("features", locale);
---

<SiteLayout locale={locale} title={copy.title} description={copy.description}>
  <div class="page-container pt-10 pb-6 lg:pt-16">
    <h1 class="max-w-[22ch] text-h1 sm:text-display">{copy.intro.heading}</h1>
    <p class="mt-5 max-w-[60ch] text-large text-secondary-foreground">{copy.intro.lead}</p>
  </div>

  <FeatureSection {...copy.answers} />
  <FeatureSection {...copy.booking} flip class="bg-card" />

  <section class="bg-accent py-16 sm:py-20">
    <div class="page-container grid items-center gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]">
      <div>
        <h2 class="text-h2">{copy.languages.heading}</h2>
        <p class="mt-3 max-w-[52ch] text-large text-secondary-foreground">{copy.languages.text}</p>
      </div>
      <div class="grid grid-cols-2 items-start gap-4 sm:gap-6">
        {copy.languages.images.map((image) => (
          <Screenshot {...image} widths={[300, 390]} sizes="(min-width: 1024px) 300px, 45vw" />
        ))}
      </div>
    </div>
  </section>

  <FeatureSection {...copy.inbox} />
  <FeatureSection {...copy.costs} flip class="bg-card" />

  <section class="page-container py-16 sm:py-20">
    <div class="flex items-center gap-4">
      <span class="grid size-12 shrink-0 place-items-center rounded-full bg-accent text-accent-foreground">
        <Icon name="shield-check" size={26} />
      </span>
      <h2 class="text-h2">{copy.privacy.heading}</h2>
    </div>
    <p class="mt-4 max-w-[60ch] text-large text-secondary-foreground">{copy.privacy.text}</p>
    <ul class="mt-8 grid gap-x-10 gap-y-4 md:grid-cols-2">
      {copy.privacy.points.map((point) => (
        <li class="flex gap-3 text-secondary-foreground">
          <Icon name="check-circle" size={20} class="mt-0.5 text-primary" />
          <span>{point}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="bg-card py-16 sm:py-20">
    <div class="page-container">
      <div class="max-w-[60ch]">
        <h2 class="text-h2">{copy.closing.heading}</h2>
        <p class="mt-3 text-large text-secondary-foreground">{copy.closing.text}</p>
        <a href={site.demoUrl} class:list={["mt-8", primaryButton]}>
          {ui[locale].tryDemo}
          <Icon name="arrow-up-right" size={20} mirrorInRtl />
        </a>
      </div>
    </div>
  </section>
</SiteLayout>
