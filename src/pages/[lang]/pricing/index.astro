---
import { primaryButton, secondaryButton } from "../../../components/buttons";
import Icon from "../../../components/Icon.astro";
import { site } from "../../../config/site";
import { isLocale } from "../../../i18n/locales";
import { ui } from "../../../i18n/ui";
import SiteLayout from "../../../layouts/SiteLayout.astro";
import { everyLanguage, pageCopy } from "../../../lib/content";

export const getStaticPaths = everyLanguage;

const { lang } = Astro.params;
if (!isLocale(lang)) throw new Error(`Unknown language "${lang}"`);
const locale = lang;
const copy = await pageCopy("pricing", locale);
---

<SiteLayout locale={locale} title={copy.title} description={copy.description}>
  <div class="page-container pt-10 pb-8 lg:pt-16">
    <h1 class="max-w-[20ch] text-h1 sm:text-display">{copy.intro.heading}</h1>
    <p class="mt-5 max-w-[60ch] text-large text-secondary-foreground">{copy.intro.lead}</p>
    <p class="mt-8 flex max-w-[72ch] gap-3 rounded-surface bg-warning-soft p-4 text-warning sm:p-5">
      <Icon name="info" size={22} class="mt-0.5" />
      <span class="font-medium">{copy.notice}</span>
    </p>
  </div>

  <div class="page-container grid gap-6 pb-16 md:grid-cols-2">
    {copy.plans.map(({ name, price, period, summary, features }, index) => (
      <section
        class:list={[
          "flex flex-col rounded-panel p-6 sm:p-8",
          index === 1 ? "bg-card shadow-level-2" : "bg-secondary",
        ]}
      >
        <h2 class="text-h3">{name}</h2>
        <p class="mt-1 text-secondary-foreground">{summary}</p>
        <p class="mt-6">
          <span class="text-h1 tabular-nums">{price}</span>{" "}
          <span class="text-small text-muted-foreground">{period}</span>
        </p>
        <ul class="mt-6 space-y-3">
          {features.map((feature) => (
            <li class="flex gap-3 text-secondary-foreground">
              <Icon name="check-circle" size={20} class="mt-0.5 text-primary" />
              <span>{feature}</span>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>

  <section class="bg-card py-16 sm:py-20">
    <div class="page-container grid gap-8 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-14">
      <div>
        <h2 class="text-h2">{copy.costs.heading}</h2>
        <p class="mt-3 text-large text-secondary-foreground">{copy.costs.text}</p>
      </div>
      <ul class="space-y-4">
        {copy.costs.points.map((point) => (
          <li class="flex gap-3 text-large text-secondary-foreground">
            <Icon name="check-circle" size={22} class="mt-1 text-primary" />
            <span>{point}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="page-container py-16 sm:py-20">
    <div class="max-w-[60ch]">
      <h2 class="text-h2">{copy.closing.heading}</h2>
      <p class="mt-3 text-large text-secondary-foreground">{copy.closing.text}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={site.demoUrl} class={primaryButton}>
          {ui[locale].tryDemo}
          <Icon name="arrow-up-right" size={20} mirrorInRtl />
        </a>
        <a href={`/${locale}/faq/`} class={secondaryButton}>
          {copy.closing.faqLink}
        </a>
      </div>
    </div>
  </section>
</SiteLayout>
