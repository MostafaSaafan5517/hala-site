---
import { getCollection, render } from "astro:content";
import Brand from "../../components/Brand.astro";
import Icon from "../../components/Icon.astro";
import { site } from "../../config/site";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { withBrand } from "../../i18n/brand";
import { localeOfEntry, locales } from "../../i18n/locales";
import { ui } from "../../i18n/ui";

export async function getStaticPaths() {
  const homes = await getCollection("pages", (entry) => entry.id.endsWith("/home"));
  return locales.map((locale) => {
    const entry = homes.find((home) => localeOfEntry(home.id) === locale);
    if (!entry) {
      throw new Error(
        `The home page has no ${locale} version: add src/content/pages/${locale}/home.mdx.`,
      );
    }
    return { params: { lang: locale }, props: { entry } };
  });
}

const { entry } = Astro.props;
const locale = localeOfEntry(entry.id);
const words = ui[locale];
const { Content } = await render(entry);
---

<SiteLayout
  locale={locale}
  title={withBrand(entry.data.title, locale)}
  description={withBrand(entry.data.description, locale)}
>
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24 lg:px-8">
    <div class="max-w-[68ch] space-y-5 text-large text-secondary-foreground [&_h1]:text-h1 [&_h1]:text-foreground sm:[&_h1]:text-display">
      <Content components={{ Brand }} />
    </div>
    <p class="mt-10 flex flex-wrap gap-3">
      <a
        class="inline-flex h-11 items-center gap-2 rounded-control bg-primary px-5 font-medium text-primary-foreground hover:bg-primary-strong active:translate-y-px motion-safe:transition-[background-color,transform]"
        href={site.demoUrl}
      >
        {words.tryDemo}
        <Icon name="arrow-up-right" size={20} mirrorInRtl />
      </a>
      <a
        class="inline-flex h-11 items-center gap-2 rounded-control bg-secondary px-5 font-medium text-foreground hover:bg-secondary-strong active:translate-y-px motion-safe:transition-[background-color,transform]"
        href={site.githubUrl}
      >
        <Icon name="github-logo" size={20} />
        {words.readCode}
      </a>
    </p>
  </div>
</SiteLayout>
