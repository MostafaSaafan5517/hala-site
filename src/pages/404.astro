---
// Cloudflare Pages serves this for any address that has no page, with a 404 status. Without it,
// Pages would treat the site as a single-page app and answer every unknown address with the root.
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../config/site";
---

<BaseLayout
  title={`Page not found | ${site.name}`}
  description="There is no page at this address. لا توجد صفحة على هذا العنوان."
>
  <main class="mx-auto grid max-w-3xl gap-6 px-4 py-16 sm:grid-cols-2 sm:px-6">
    <section class="rounded-2xl bg-white p-6 shadow-sm">
      <h1 class="text-2xl font-semibold">Page not found</h1>
      <p class="mt-3 text-stone-700">There is no page at this address.</p>
      <a class="mt-4 inline-block font-medium text-teal-900 underline" href="/en/" hreflang="en">
        Go to the home page
      </a>
    </section>
    <section lang="ar" dir="rtl" class="rounded-2xl bg-white p-6 shadow-sm">
      <h2 class="text-2xl font-semibold">الصفحة غير موجودة</h2>
      <p class="mt-3 text-stone-700">لا توجد صفحة على هذا العنوان.</p>
      <a class="mt-4 inline-block font-medium text-teal-900 underline" href="/ar/" hreflang="ar">
        اذهب إلى الصفحة الرئيسية
      </a>
    </section>
  </main>
</BaseLayout>
