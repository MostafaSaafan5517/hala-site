---
import { Font } from "astro:assets";
import "../styles/global.css";
import { localeInfo, type Locale } from "../i18n/locales";

interface Props {
  /**
   * The page's language. Without one the page is bilingual (the root, the 404): English, with its
   * Arabic parts marked.
   */
  locale?: Locale;
  title: string;
  description: string;
}

const { locale, title, description } = Astro.props;
const lang = locale ?? "en";
// Preload the font files the first screen needs. English pages need only the Latin file (their
// one Arabic word, in the header, measured no visible shift). Arabic pages need both: the Latin
// file's range includes the space, digits and brackets that Arabic text uses, so without it every
// space was drawn in the fallback until it arrived, and the lines re-wrapped (a measured shift of
// 0.049). Bilingual pages (the root, the 404) show both scripts.
const subsets = locale === "en" ? ["latin"] : ["latin", "arabic"];
---

<!doctype html>
<html lang={lang} dir={localeInfo[lang].dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <Font cssVariable="--font-readex" preload={subsets.map((subset) => ({ subset }))} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <slot name="head" />
  </head>
  <body class="antialiased">
    <slot />
  </body>
</html>
