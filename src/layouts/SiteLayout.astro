---
// Every page in one language: skip link, header, the page in <main>, footer.
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import type { Locale } from "../i18n/locales";
import { ui } from "../i18n/ui";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  locale: Locale;
  /** The language switch's target, when it isn't this page in the other language. */
  alternateHref?: string;
  title: string;
  description: string;
}

const { locale, title, description, alternateHref } = Astro.props;
---

<BaseLayout locale={locale} title={title} description={description}>
  <div class="flex min-h-dvh flex-col">
    <a
      href="#content"
      class="sr-only rounded-control bg-primary px-4 py-2 font-medium text-primary-foreground focus:not-sr-only focus:absolute focus:start-4 focus:top-3"
    >
      {ui[locale].skipToContent}
    </a>
    <SiteHeader locale={locale} alternateHref={alternateHref} />
    <main id="content" tabindex="-1" class="flex-1 focus:outline-none">
      <slot />
    </main>
    <SiteFooter locale={locale} />
  </div>
  <script>
    import { rememberLocaleOnClick } from "../i18n/remember";

    rememberLocaleOnClick();
  </script>
</BaseLayout>
